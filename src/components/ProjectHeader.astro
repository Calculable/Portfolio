---
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class:list={['project-header', {'has-cover': page.heroImage}]}>
  <div class="project-heading">
    {page.heroIcon && <img class="project-icon" src={`${base}${page.heroIcon}`} alt="" width="96" height="96" />}
    <h1>{page.heading}</h1>
  </div>
  {page.heroImage && <img class="project-cover" src={`${base}${page.heroImage}`} alt="" />}
</header>
