---
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="project-header">
  <div class="project-heading">
    {page.heroIcon && <img class="project-icon" src={`${base}${page.heroIcon}`} alt="" width="96" height="96" />}
    <h1>{page.heading}</h1>
  </div>
</header>
