---
// Only the configured public site can load analytics, including in built previews.
const productionHost = Astro.site?.hostname;
---
{import.meta.env.PROD && productionHost && (
  <script is:inline define:vars={{ productionHost }}>
    if (location.hostname === productionHost && navigator.doNotTrack !== '1') {
      const script = document.createElement('script');
      script.src = 'https://gc.zgo.at/count.js';
      script.async = true;
      script.dataset.goatcounter = 'https://janhuber.goatcounter.com/count';
      document.head.appendChild(script);
    }
  </script>
)}
