---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="site-header">
  <a class="wordmark" href={`${base}/`}>Jan Huber</a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" hidden>
    <span>Menü</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
  </button>
  <div class="site-menu" id="site-menu">
  <nav aria-label="Hauptnavigation">
    <a class:list={{ active: Astro.url.pathname.replace(/\/$/, "").endsWith("/portfolio") }} aria-current={Astro.url.pathname.replace(/\/$/, "").endsWith("/portfolio") ? "page" : undefined} href={`${base}/portfolio/`}>Fotoarchiv</a>
    <a href={`${base}/#page-section-625aab9ff90d7a4b52b57ace`}>Projekte</a>
  </nav>
  <div class="header-actions">
    <a class="social" href="https://github.com/Calculable" aria-label="GitHub">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.33 4.69-4.56 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
    </a>
    <a class="social linkedin" href="https://www.linkedin.com/in/jan-huber-290980238" aria-label="LinkedIn">in</a>
    <a class="contact-link" href={`${base}/kontakt`}>Kontakt</a>
  </div>
  </div>
</header>
<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  if (header && toggle) {
    toggle.hidden = false;
    header.classList.add('menu-ready');
    const closeMenu = () => toggle.setAttribute('aria-expanded', 'false');
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
    });
    header.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });
    header.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) closeMenu();
    });
    matchMedia('(min-width: 761px)').addEventListener('change', closeMenu);
  }
</script>
