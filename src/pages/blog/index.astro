---
import Layout from '../../components/blog/Layout.astro';
import { articles, day, displayDay, overviewPhotos } from '../../components/blog/articles';
---
<Layout title="Ausflüge">
  <h1 class="sr-only">Fotografien von Jan Huber</h1>
  {articles.length === 0 && <p class="meta">Noch keine Artikel.</p>}
  {articles.map(article => <article class="story">
    <a class="story-card" href={'/blog/'+article.slug+'/'} aria-label={'Artikel ansehen: '+article.title}>
      <div class="story-heading">
        <div><p class="meta"><time datetime={day(article)}>{displayDay(article)}</time></p><h2>{article.title}</h2></div>
        <span class="story-action">Artikel ansehen <span aria-hidden="true">→</span></span>
      </div>
      <div class="story-images" data-count={Math.min(article.photos.length, 3)}>
        {overviewPhotos(article).map(photo => <img src={photo.image} alt={photo.alt}/>)}
      </div>
    </a>
  </article>)}
  <p class="meta"><a href="/blog/rss.xml">RSS</a></p>
</Layout>

<style>
  .story { margin-bottom: clamp(32px, 5vw, 64px); }
  .story-card { display: block; }
  .story-heading { display: flex; justify-content: space-between; align-items: end; gap: 16px; padding: 4px 0 clamp(16px, 2vw, 24px); }
  .story-heading h2 { overflow-wrap: anywhere; }
  .story-action { font-size: 13px; white-space: nowrap; line-height: 1.6; }
  .story-action span { margin-left: 4px; }
  .story-card:is(:hover, :focus-visible) .story-action { text-decoration: underline; text-underline-offset: 4px; }
  .story-images { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); grid-auto-rows: minmax(0, 1fr); aspect-ratio: 2.5; gap: 6px; }
  .story-images img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .story-images[data-count="3"] img:first-child { grid-row: span 2; }
  .story-images[data-count="1"] { grid-template-columns: 1fr; }
  @media (max-width: 600px) {
    .story-heading { align-items: start; flex-direction: column; gap: 8px; }
    .story-images { aspect-ratio: 1.6; gap: 4px; }
  }
</style>
