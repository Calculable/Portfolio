---
import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Remove when the portfolio is ready to appear in search results. -->
    <meta name="robots" content="noindex" />
    <meta name="description" content="Mein Portfolio entsteht hier. Willkommen auf meiner Webseite." />
    <title>Hello World | Portfolio</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">PORTFOLIO · DER ANFANG</p>
      <h1>Hello World<span>.</span></h1>
      <p class="intro">Schön, dass du da bist.<br />Hier entsteht mein Portfolio.</p>
      <button id="hello-button" type="button" hidden>Hallo sagen <span aria-hidden="true">↗</span></button>
      <p id="greeting" class="greeting" role="status"></p>
      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Kontakt</h2>
        <p>Du hast eine Frage oder möchtest Hallo sagen? Schreib mir.</p>
        <form action="https://usebasin.com/f/ff509d632e80" method="POST">
          <!-- Keep these identifiers unique when reusing this form on other sites. -->
          <input type="hidden" name="site_source" value="https://calculable.github.io/Portfolio/" />
          <input type="hidden" name="form_source" value="portfolio-contact" />
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="200" />
          <label for="contact-email">E-Mail</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          <label for="contact-message">Nachricht</label>
          <textarea id="contact-message" name="message" rows="6" required maxlength="10000"></textarea>
          <p class="form-note">Alle Felder sind erforderlich. Deine Angaben werden zur Bearbeitung deiner Anfrage über Basin übermittelt.</p>
          <button type="submit">Nachricht senden <span aria-hidden="true">↗</span></button>
        </form>
      </section>
      <footer>Ein kleiner Anfang. Viel Platz für Ideen.</footer>
    </main>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
